generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH TABLES ───────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── USER & PROFILES ──────────────────────────────────────

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           UserRole  @default(FREELANCER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  freelancerProfile FreelancerProfile?
  contributorProfile ContributorProfile?
  jobs              Job[]
  campaigns         DataCollectionCampaign[]
  proposals         Proposal[]
  contractsAsClient    Contract[] @relation("ClientContracts")
  contractsAsFreelancer Contract[] @relation("FreelancerContracts")
  sentMessages      Message[]  @relation("SentMessages")
  receivedMessages  Message[]  @relation("ReceivedMessages")
  reviewsGiven      Review[]   @relation("ReviewsGiven")
  reviewsReceived   Review[]   @relation("ReviewsReceived")
  payouts           Payout[]
  taskSubmissions   TaskSubmission[]
}

model FreelancerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  tagline         String?
  bio             String?  @db.Text
  hourlyRate      Float?
  availability    String   @default("available") // available, busy, unavailable
  yearsExperience Int?
  location        String?
  languages       String[] @default([])
  isDataContributor Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         Skill[]
  portfolioItems PortfolioItem[]
}

model ContributorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  tasksCompleted  Int      @default(0)
  languagesSpoken String[] @default([])
  accuracyScore   Float    @default(0)
  datasetsContributed Int  @default(0)
  isVerified      Boolean  @default(false)
  onboardingComplete Boolean @default(false)
  ndaSigned       Boolean  @default(false)
  deviceType      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accuracyScores  AccuracyScore[]
}

// ─── SKILLS & PORTFOLIO ───────────────────────────────────

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String // "AI Development", "Data Collection", "Specialties"

  freelancerProfiles FreelancerProfile[]
  jobs               Job[]
}

model PortfolioItem {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  link        String?
  thumbnail   String?
  profileId   String

  profile FreelancerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── JOBS ─────────────────────────────────────────────────

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobType {
  STANDARD
  DATA_COLLECTION
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  type        JobType   @default(STANDARD)
  status      JobStatus @default(OPEN)
  budgetMin   Float?
  budgetMax   Float?
  budgetType  String?   // "hourly", "fixed", "per_task", "per_item"
  duration    String?
  clientId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client    User       @relation(fields: [clientId], references: [id])
  skills    Skill[]
  proposals Proposal[]
  contracts Contract[]

  // Data collection specific
  campaign DataCollectionCampaign?
}

// ─── DATA COLLECTION ──────────────────────────────────────

enum DataType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  MULTILINGUAL
  BEHAVIORAL
}

enum TaskType {
  LABELING
  ANNOTATION
  TRANSCRIPTION
  TRANSLATION
  RECORDING
  PREFERENCE_RANKING
  SURVEY
  WEB_SCRAPING
}

model DataCollectionCampaign {
  id                  String   @id @default(cuid())
  jobId               String   @unique
  clientId            String
  dataType            DataType
  taskType            TaskType
  volumeDescription   String?
  languagesRequired   String[] @default([])
  qualityAccuracy     Float?
  qualityReviewRounds Int?
  contributorRequirements String? @db.Text // JSON string for accent, age, location, etc.
  sampleTaskUrl       String?
  budgetPerTask       Float?
  budgetPerItem       Float?
  flatFee             Float?
  ndaRequired         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client      User        @relation(fields: [clientId], references: [id])
  taskBatches TaskBatch[]
}

model TaskBatch {
  id           String   @id @default(cuid())
  campaignId   String
  name         String
  description  String?
  totalItems   Int      @default(0)
  completedItems Int    @default(0)
  status       String   @default("active") // active, paused, completed
  reviewsPerItem Int    @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign  DataCollectionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  taskItems TaskItem[]
}

model TaskItem {
  id          String  @id @default(cuid())
  batchId     String
  data        String  @db.Text // JSON: the task content (text, image url, audio url, etc.)
  labels      String? // JSON: configured label options
  status      String  @default("pending") // pending, in_progress, completed, flagged
  payPerItem  Float?
  estimatedTime Int?  // in seconds
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batch       TaskBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions TaskSubmission[]
}

model TaskSubmission {
  id          String   @id @default(cuid())
  taskItemId  String
  userId      String
  response    String   @db.Text // JSON: the contributor's response
  status      String   @default("pending") // pending, approved, rejected
  timeSpent   Int?     // in seconds
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskItem TaskItem @relation(fields: [taskItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

// ─── PROPOSALS & CONTRACTS ────────────────────────────────

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Proposal {
  id            String         @id @default(cuid())
  jobId         String
  freelancerId  String
  coverLetter   String         @db.Text
  proposedRate  Float
  estimatedDays Int?
  attachments   String[]       @default([])
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer User     @relation(fields: [freelancerId], references: [id])
  contract   Contract?
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

model Contract {
  id           String         @id @default(cuid())
  jobId        String
  proposalId   String         @unique
  clientId     String
  freelancerId String
  totalAmount  Float
  status       ContractStatus @default(ACTIVE)
  startDate    DateTime       @default(now())
  endDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  job        Job         @relation(fields: [jobId], references: [id])
  proposal   Proposal    @relation(fields: [proposalId], references: [id])
  client     User        @relation("ClientContracts", fields: [clientId], references: [id])
  freelancer User        @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  milestones Milestone[]
  reviews    Review[]
}

model Milestone {
  id          String   @id @default(cuid())
  contractId  String
  name        String
  description String?  @db.Text
  amount      Float
  dueDate     DateTime?
  status      String   @default("pending") // pending, in_progress, completed, approved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ─── MESSAGING ────────────────────────────────────────────

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  contractId  String?
  content     String   @db.Text
  attachments String[] @default([])
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// ─── REVIEWS ──────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  contractId  String
  reviewerId  String
  revieweeId  String
  rating      Float
  comment     String?  @db.Text
  accuracyRating   Float? // for data contributors
  reliabilityScore Float? // for data contributors
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  reviewer User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
}

model AccuracyScore {
  id            String   @id @default(cuid())
  contributorId String
  campaignId    String?
  score         Float
  totalTasks    Int
  approvedTasks Int
  createdAt     DateTime @default(now())

  contributor ContributorProfile @relation(fields: [contributorId], references: [id])
}

// ─── PAYOUTS ──────────────────────────────────────────────

model Payout {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      String   // "milestone", "task", "bonus"
  status    String   @default("pending") // pending, processing, completed, failed
  reference String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
